# phish_wu behind nginx on a single Ubuntu host.
#
# Two server blocks because the two halves have opposite exposure needs: the
# phishing server has to be reachable by the people being tested, the admin
# interface must not be.
#
#   cp nginx.conf.example /etc/nginx/sites-available/phish_wu
#   ln -s /etc/nginx/sites-available/phish_wu /etc/nginx/sites-enabled/
#   rm -f /etc/nginx/sites-enabled/default
#   nginx -t && systemctl reload nginx
#
# Certificates, assuming certbot:
#   certbot certonly --nginx -d phish.example.com -d admin.example.com
#
# Remember to set trusted_origins in config.json to the admin hostname, or the
# CSRF origin check rejects every login attempt through the proxy.

# ---------------------------------------------------------------------------
# Phishing server - public
# ---------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name phish.example.com;

    # certbot's HTTP-01 challenge has to stay on port 80
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # "listen ... http2" is the form Ubuntu's nginx understands. 22.04 ships
    # 1.18 and 24.04 ships 1.24; the separate "http2 on;" directive only
    # exists from 1.25.1 onwards. On 1.25+ this still works, with a
    # deprecation warning.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name phish.example.com;

    ssl_certificate     /etc/letsencrypt/live/phish.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/phish.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # The landing page is attacker-controlled HTML by design, so do not add
    # security headers here that would change how it renders.

    access_log /var/log/nginx/phish_wu-phish.access.log;

    location / {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Recipients may submit large forms or upload-looking payloads.
        client_max_body_size 25m;
    }
}

# ---------------------------------------------------------------------------
# Admin interface - restricted
# ---------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name admin.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.example.com;

    ssl_certificate     /etc/letsencrypt/live/admin.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Restrict to the addresses your operators come from. A VPN range, the
    # office egress, a bastion - whatever applies. Anyone who reaches this
    # interface can read every captured credential.
    #
    # allow 203.0.113.0/24;
    # allow 198.51.100.17/32;
    # deny  all;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff"          always;
    add_header Referrer-Policy           "same-origin"      always;

    access_log /var/log/nginx/phish_wu-admin.access.log;

    location / {
        # gophish keeps TLS on for the admin interface even on loopback, so
        # that its session cookie carries the Secure flag. The certificate it
        # generates is self-signed, hence proxy_ssl_verify off - the connection
        # never leaves the host.
        proxy_pass         https://127.0.0.1:3333;
        proxy_ssl_verify   off;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Email templates with attachments are posted as base64 in JSON.
        client_max_body_size 50m;
        proxy_read_timeout   300s;
    }
}
